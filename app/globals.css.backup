@import "tailwindcss";

:root {
  --background: #fafaf9;
  --foreground: #1c1917;
}

html.dark {
  --background: #0c0a09;
  --foreground: #f5f5f4;
}

html,
body {
  min-height: 100%;
}

body {
  background: var(--background);
  color: var(--foreground);
  transition:
    background-color 0.2s ease,
    color 0.2s ease;
}
